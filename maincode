#include <Servo.h>

Servo fr_j, fr_a, fr_w;
Servo br_j, br_a, br_w;
Servo fl_j, fl_a, fl_w;
Servo bl_j, bl_a, bl_w;
Servo headServo;

int headAngle = 90;

void stand()
{
  fl_j.write(92);
  fr_j.write(92);
  fl_a.write(114);
  fr_a.write(71);
  fl_w.write(100);
  fr_w.write(78);

  bl_j.write(98);
  br_j.write(92);
  bl_a.write(114);
  br_a.write(66);
  bl_w.write(111);
  br_w.write(84);
}

void sit()
{
  fl_j.write(92);
  fr_j.write(92);
  fl_a.write(180);
  fr_a.write(0);
  fl_w.write(0);
  fr_w.write(180);

  bl_j.write(98);
  br_j.write(92);
  bl_a.write(180);
  br_a.write(0);
  bl_w.write(0);
  br_w.write(180);
}

void sit_stand()
{
  fr_j.write(95);
  fl_j.write(80);
  br_j.write(90);
  bl_j.write(82);

  fr_a.write(50);
  fl_a.write(120);
  br_a.write(0);
  bl_a.write(180);

  fr_w.write(70);
  fl_w.write(110);
  br_w.write(155);
  bl_w.write(25);
}

void smoothStand()
{
  for (int i = 0; i <= 20; i++)
  {
    fl_a.write(map(i, 0, 20, 180, 114));
    fr_a.write(map(i, 0, 20, 0, 71));

    fl_w.write(map(i, 0, 20, 0, 100));
    fr_w.write(map(i, 0, 20, 180, 78));

    bl_a.write(map(i, 0, 20, 180, 114));
    br_a.write(map(i, 0, 20, 0, 66));

    bl_w.write(map(i, 0, 20, 0, 111));
    br_w.write(map(i, 0, 20, 180, 84));

    delay(50);
  }
}

void smoothSit()
{
  for (int i = 0; i <= 20; i++)
  {
    fl_a.write(map(i, 0, 20, 114, 180));
    fr_a.write(map(i, 0, 20, 71, 0));

    fl_w.write(map(i, 0, 20, 100, 0));
    fr_w.write(map(i, 0, 20, 78, 180));

    bl_a.write(map(i, 0, 20, 114, 180));
    br_a.write(map(i, 0, 20, 66, 0));

    bl_w.write(map(i, 0, 20, 111, 0));
    br_w.write(map(i, 0, 20, 84, 180));

    delay(50);
  }
}

void crawl()
{
  for (int i = 0; i <= 20; i++)
  {
    fl_a.write(map(i, 0, 20, 180, 130));
    br_a.write(map(i, 0, 20, 0, 40));

    fl_w.write(map(i, 0, 20, 0, 20));
    br_w.write(map(i, 0, 20, 180, 150));

    delay(50);

    fr_a.write(map(i, 0, 20, 0, 40));
    bl_a.write(map(i, 0, 20, 180, 130));

    fr_w.write(map(i, 0, 20, 180, 150));
    bl_w.write(map(i, 0, 20, 0, 20));

    delay(50);
  }
}

void smoothHeadTransition(int targetAngle)
{
  int step = (targetAngle > headAngle) ? 1 : -1;

  for (int i = headAngle; i != targetAngle; i += step)
  {
    headServo.write(i);
    delay(20);
  }

  headAngle = targetAngle;
}

void setup()
{
  Serial1.begin(9600);

  headServo.attach(30);
  headServo.write(headAngle);

  fr_j.attach(2);
  fr_a.attach(3);
  fr_w.attach(4);

  br_j.attach(5);
  br_a.attach(6);
  br_w.attach(7);

  fl_j.attach(8);
  fl_a.attach(9);
  fl_w.attach(10);

  bl_j.attach(11);
  bl_a.attach(12);
  bl_w.attach(13);

  sit();

  delay(1000);
}

void loop()
{
  if (Serial1.available())
  {
    char c = Serial1.read();

    if (c == 'L')
    {
      if (headAngle > 0)
      {
        smoothHeadTransition(max(0, headAngle - 10));
      }
    }

    else if (c == 'R')
    {
      if (headAngle < 180)
      {
        smoothHeadTransition(min(180, headAngle + 10));
      }
    }

    else if (c == 'F')
    {
      smoothStand();
    }

    else if (c == 'B')
    {
      smoothSit();
    }

    else if (c == 'W')
    {
      crawl();
    }
  }
}
